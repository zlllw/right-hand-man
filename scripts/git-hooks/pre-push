#!/usr/bin/env bash
# 本地主干保护：拒绝删除 master，或把 master 推成非快进（强制推送/改写历史）。
# 远端服务器级保护需要仓库公开或 GitHub Pro；本钩子只作用于当前克隆。
set -u

protected="refs/heads/master"
zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$protected" ] || continue

  if [ "$local_sha" = "$zero" ]; then
    printf 'pre-push: 拒绝删除 %s\n' "$protected" >&2
    status=1
    continue
  fi

  if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    printf 'pre-push: 拒绝强制推送 %s（远端提交不在本地历史中）\n' "$protected" >&2
    printf '          先 git fetch；确实需要改写历史时再显式绕过本地保护。\n' >&2
    status=1
  fi
done

exit "$status"